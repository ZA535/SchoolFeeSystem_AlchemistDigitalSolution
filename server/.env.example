SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Auth (required — use a long random string, e.g. openssl rand -base64 48)
JWT_SECRET=
JWT_EXPIRES_IN=8h

# One-time admin bootstrap (npm run seed:admin — do not commit real passwords)
ADMIN_EMAIL=admin@school.local
ADMIN_PASSWORD=
ADMIN_NAME=School Admin

PORT=4000
CLIENT_ORIGIN=http://localhost:5173
APP_TIMEZONE=Asia/Karachi
NODE_ENV=development
REQUEST_TIMEOUT_MS=30000
DB_TIMEOUT_MS=20000
API_RATE_LIMIT_PER_MIN=300